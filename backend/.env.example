# Copy this file to backend/.env and adjust as needed.
# Used both for local `uvicorn --reload` runs and by docker-compose.yml
# (which loads it via `env_file: backend/.env`).

# --- Database ---
# For local (non-docker) runs, this points at the docker-compose postgres
# service via its host-mapped port 5433.
# NOTE: when running via `docker compose up`, this value is overridden by the
# `DATABASE_URL` set directly in docker-compose.yml's `app.environment` block
# (containers talk to the `postgres` service on port 5432, not 5433) — you
# don't need to change it for the docker path, only for running the backend
# outside docker against the compose postgres container.
DATABASE_URL=postgresql+asyncpg://gogetcrm:gogetcrm@localhost:5433/gogetcrm

# --- Auth ---
# Generate a real secret before any shared/deployed use, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- File uploads ---
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8070/uploads

# --- SMTP (transactional email; optional — leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gogetcrm.local
SMTP_FROM_NAME=GOGET CRM
SMTP_USE_TLS=true

# Signup email verification codes (routers/auth.py) are sent from this
# address instead of SMTP_FROM, as the SaaS platform owner rather than the
# generic no-reply address — SMTP_USER must be authorized to send as it.
VERIFICATION_FROM_EMAIL=info@go-get.ca

# --- Microsoft Graph (preferred mail sender when all three are filled in —
# many Microsoft 365 tenants block basic-auth SMTP under Security Defaults,
# see adapters/email.py). Requires an Entra ID app registration with the
# Mail.Send application permission, ideally scoped to one mailbox via
# New-ApplicationAccessPolicy in Exchange Online PowerShell. ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Google OAuth ("Connect Gmail" in Settings > Email — a per-user, per-
# firm connection, distinct from the Graph service account above. Any staff
# member who connects sends CRM email as themselves instead of the shared
# sender.) Requires a Google Cloud OAuth 2.0 Client (Web application type)
# with the Gmail API enabled and the gmail.send scope on the consent screen.
# GOOGLE_OAUTH_REDIRECT_URI must exactly match a redirect URI registered on
# that OAuth client. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8070/api/integrations/google/callback

# --- Microsoft per-user OAuth ("Connect OneDrive" and "Connect Outlook" in
# Settings > Email — per-user connections, same idea as Google above but for
# file storage / mail-send instead of Gmail: each staff member or client
# connects their own personal, work, or school Microsoft account, and synced
# filing/signature documents (OneDrive) or Compose-screen emails (Outlook)
# go through *their* account, not one shared firm-wide identity.) Requires
# an Entra ID app registration (can be the same one as GRAPH_CLIENT_ID above,
# or a separate one) with delegated Files.ReadWrite + Mail.Send +
# offline_access + User.Read permissions, "supported account types" set to
# "Accounts in any organizational directory and personal Microsoft
# accounts", and both redirect URIs below registered as exact-match Web
# redirect URIs. ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:8070/api/integrations/onedrive/callback
OUTLOOK_REDIRECT_URI=http://localhost:8070/api/integrations/outlook/callback

# Encrypts connected-account OAuth tokens at rest (app/security.py). Generate
# your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- GroqCloud LLM (optional — leave blank to disable the marketing chatbot) ---
# Powers /api/public/chatbot (routers/public.py). Get a key at console.groq.com.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# --- Bootstrap admin (created by `python -m app.seed`) ---
SEED_ADMIN_EMAIL=admin@gogetcrm.local
SEED_ADMIN_PASSWORD=change-me-please

# --- Misc ---
CONTACT_INBOX_EMAIL=hello@gogetcrm.ca

# Used to build invite/verification-email links and OAuth callback redirects.
FRONTEND_BASE_URL=http://localhost:5173
