# Optional — read by `docker compose` itself (NOT by the app) for ${...}
# substitution in docker-compose.yml. Copy to .env in the repo root only if
# you want to override these for a real deployment; harmless to omit for
# local dev, both fall back to dev-safe defaults.

# Baked into the frontend JS bundle at Docker build time — must be the public
# URL visitors will actually use, e.g. https://aeasy.ca. Left unset/default,
# every visitor's browser will try to call http://localhost:8070 instead of
# your real domain, which breaks the whole app for anyone but you.
VITE_API_BASE_URL=https://aeasy.ca

# Postgres superuser password for the postgres container. The default
# ("gogetcrm") is fine for local dev since that port is bound to 127.0.0.1
# only (see docker-compose.yml) — but set a real random value here before a
# production deploy for defense-in-depth.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
