# Copy this file to .env.local and adjust as needed.
# Read by Vite at `npm run dev` / `npm run build` time (root of the repo,
# same directory as vite.config.js). Not used by the Docker build — see
# Dockerfile's VITE_API_BASE_URL build-arg for that path instead.

# Backend API base URL. Defaults to same-origin/localhost:8070 if unset.
VITE_API_BASE_URL=http://localhost:8070

# Stripe publishable (public) key, used by the client-side Stripe.js
# checkout on the billing page. Leave blank if Stripe isn't configured yet.
VITE_STRIPE_PUBLISHABLE_KEY=
